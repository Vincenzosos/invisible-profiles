# Suggested .gitignore for the thesis repo
# Place this content at: /Users/vincenzosilvestri/Desktop/SHARE DATASET/DATASET RESEARCH/.gitignore

# ---- SHARE raw data (large, licensed, NEVER commit) ----------------------
*.dta
SHARE_release_guide_*.pdf

# ---- macOS ---------------------------------------------------------------
.DS_Store
*.swp
.~lock.*
.~$*

# ---- R session and history -----------------------------------------------
.Rhistory
.Rapp.history
.RData
.Ruserdata

# ---- R outputs (regenerated by pipeline) ---------------------------------
v9/outputs/*.rds
v9/outputs/*.csv
v9/outputs/*.md

# ---- LaTeX intermediate files --------------------------------------------
*.aux
*.log
*.out
*.toc
*.lot
*.lof
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.synctex.gz
*.run.xml
*.nav
*.snm

# ---- Compiled PDFs (rebuild on demand) -----------------------------------
# Comment out the next line if you want to track compiled PDFs in git.
Invisible_Profiles_LaTeX_Overleaf/main.pdf

# ---- Node modules / webapp build artifacts -------------------------------
node_modules/
webapp/dist/
webapp/.vite/
webapp/.next/
webapp/.turbo/
.env
.env.local

# ---- Editor / IDE --------------------------------------------------------
.vscode/
.idea/
*.iml

# ---- Trentini submission (regenerable) -----------------------------------
# Uncomment if you want them out of git. Default keeps them.
# Trentini_submission/*.pdf
# Trentini_submission/*.docx

# ---- Zip backups ---------------------------------------------------------
Overleaf_*.zip
*.zip

# ---- Day-1 cleanup additions ---------------------------------------------
.claude/
*.tmp
.~lock.*

# ---- W8 reproducibility clone (cp -r v9 v9_w8 fallout) -------------------
# Only the 9 patched .R scripts in v9_w8/ are tracked; the rest is binary
# fallout from the cp and is not re-generated by the W8 pipeline (outputs
# are redirected to v9/outputs/ with _w8 suffix).
v9_w8/outputs/
v9_w8/figures/
v9_w8/data/
v9_w8/**/*.rds
v9_w8/**/*.csv
v9_w8/**/*.pdf
v9_w8/**/*.png

# ---- Scratch / local exports (never commit) ------------------------------
*.bak_*
*_FINAL.pdf
*.docx
main_check*
# dated exports (e.g. Briefing_..._2026-05-04.pdf, Cut_analysis_..._2026-06-07.md)
*_2026-*.pdf
*_2026-*.md
