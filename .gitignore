# Suggested .gitignore for the thesis repo
# Place this content at: /Users/vincenzosilvestri/Desktop/SHARE DATASET/DATASET RESEARCH/.gitignore

# ---- SHARE raw data (large, licensed, NEVER commit) ----------------------
*.dta
SHARE_release_guide_*.pdf

# ---- macOS ---------------------------------------------------------------
.DS_Store
*.swp
.~lock.*
.~$*

# ---- R session and history -----------------------------------------------
.Rhistory
.Rapp.history
.RData
.Ruserdata

# ---- R outputs (regenerated by pipeline) ---------------------------------
v9/outputs/*.rds
v9/outputs/*.csv
v9/outputs/*.md

# ---- LaTeX intermediate files --------------------------------------------
*.aux
*.log
*.out
*.toc
*.lot
*.lof
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.synctex.gz
*.run.xml
*.nav
*.snm

# ---- Compiled PDFs (rebuild on demand) -----------------------------------
# Comment out the next line if you want to track compiled PDFs in git.
Invisible_Profiles_LaTeX_Overleaf/main.pdf

# ---- Node modules / webapp build artifacts -------------------------------
node_modules/
webapp/dist/
webapp/.vite/
webapp/.next/
webapp/.turbo/
.env
.env.local

# ---- Editor / IDE --------------------------------------------------------
.vscode/
.idea/
*.iml

# ---- Trentini submission (regenerable) -----------------------------------
# Uncomment if you want them out of git. Default keeps them.
# Trentini_submission/*.pdf
# Trentini_submission/*.docx

# ---- Zip backups ---------------------------------------------------------
Overleaf_*.zip
*.zip
